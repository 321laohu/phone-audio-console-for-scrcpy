<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色（宣纸） ============ -->
    <Color x:Key="L_Bg1">#A8B8FF</Color>
    <Color x:Key="L_Bg2">#FFC4E8</Color>
    <Color x:Key="L_Bg3">#9FE8FF</Color>
    <Color x:Key="L_BgBase">#D8D2C4</Color>
    <SolidColorBrush x:Key="L_Glass" Color="#80FCF9F3"/>
    <SolidColorBrush x:Key="L_Border" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="L_Text" Color="#1C1914"/>
    <SolidColorBrush x:Key="L_SubText" Color="#991C1914"/>
    <SolidColorBrush x:Key="L_Panel" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="L_PanelBorder" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="L_Accent" Color="#FF1C1914"/>

    <!-- ============ 深色（墨夜） ============ -->
    <Color x:Key="D_Bg1">#2B4A6E</Color>
    <Color x:Key="D_Bg2">#4A2A5E</Color>
    <Color x:Key="D_Bg3">#245A52</Color>
    <Color x:Key="D_BgBase">#0D1013</Color>
    <SolidColorBrush x:Key="D_Glass" Color="#75121517"/>
    <SolidColorBrush x:Key="D_Border" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="D_Text" Color="#EAE4D7"/>
    <SolidColorBrush x:Key="D_SubText" Color="#99EAE4D7"/>
    <SolidColorBrush x:Key="D_Panel" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="D_PanelBorder" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="D_Accent" Color="#FFE8E3D6"/>

    <!-- ============ 错误色 ============ -->
    <SolidColorBrush x:Key="ErrColor" Color="#FFC0392B"/>
    <SolidColorBrush x:Key="ErrBgLight" Color="#1FC0392B"/>
    <SolidColorBrush x:Key="ErrBgDark" Color="#2EC0392B"/>

    <!-- ============ 标题栏圆形按钮 ============ -->
    <Style x:Key="TitleButton" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
